APP_NAME=TeamNav
APP_URL=http://localhost:3000
# Keep empty for the portable same-origin Docker image. Local development defaults to port 8000.
NEXT_PUBLIC_API_URL=
TEAMNAV_PORT=3000
TEAMNAV_VERSION=latest
TEAMNAV_API_IMAGE=glfc2b/teamnav-api
TEAMNAV_WEB_IMAGE=glfc2b/teamnav-web
TEAMNAV_AIO_IMAGE=glfc2b/teamnav-aio
# Omit DATABASE_URL for the default SQLite Docker deployment.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/teamnav
# DATABASE_URL=mysql+asyncmy://user:password@host:3306/teamnav?charset=utf8mb4
SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Bundled database passwords are interpolated into DATABASE_URL. Use URL-safe characters only.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
CAPTCHA_REQUIRED=true
CAPTCHA_TTL_SECONDS=300
EDIT_SESSION_DAYS=7
ACCESS_SESSION_HOURS=24
ACCOUNT_SESSION_DAYS=30
ADMIN_SESSION_HOURS=8
MAX_SITES_PER_IP_PER_HOUR=5
MAX_SITES_PER_IP_PER_DAY=20
MAX_CATEGORIES_PER_SITE=200
MAX_LINKS_PER_SITE=2000
LINK_CHECK_SCHEDULER_ENABLED=true
LINK_CHECK_POLL_SECONDS=900
LINK_CHECK_TIMEOUT_SECONDS=5
LINK_CHECK_BATCH_SIZE=50
# Keep false on public deployments to block localhost and private-network targets.
LINK_CHECK_ALLOW_PRIVATE_NETWORKS=false
DEFAULT_NOINDEX=true
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
